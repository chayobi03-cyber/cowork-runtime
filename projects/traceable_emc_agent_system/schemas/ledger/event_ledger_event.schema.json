{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ledger/event_ledger_event.schema.json",
  "title": "Event Ledger Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "event_type",
    "actor",
    "target",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{4,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "input_loaded",
        "annotation_created",
        "rag_retrieved",
        "tool_executed",
        "agent_generated",
        "evaluation_completed",
        "decision_recorded",
        "error",
        "run_finished"
      ]
    },
    "actor": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "related_run_id": {
      "type": "string"
    },
    "related_scenario_id": {
      "type": "string"
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "default": "info"
    }
  }
}
