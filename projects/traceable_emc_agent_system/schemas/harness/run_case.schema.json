{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/harness/run_case.schema.json",
  "title": "Run Case",
  "type": "object",
  "required": [
    "run_id",
    "scenario_id",
    "run_mode",
    "started_at",
    "nodes_to_run",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4,}$"
    },
    "scenario_id": {
      "type": "string"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "dry_run",
        "tool_only",
        "rag_only",
        "full_case",
        "replay"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes_to_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_bundle_path": {
      "type": "string"
    },
    "output_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "error_summary": {
      "type": "string"
    }
  }
}
